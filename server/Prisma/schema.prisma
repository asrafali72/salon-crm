generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleName {
  OWNER
  ADMIN
  RECEPTIONIST
  STYLIST
  ASSISTANT
  CUSTOMER
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  roleId       String
  status       UserStatus   @default(ACTIVE)

  role         Role         @relation(fields: [roleId], references: [id])
  branches     UserBranch[]

  staff        Staff?
  customer     Customer?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([roleId])
  @@index([status])
}

model Role {
  id          String     @id @default(cuid())
  name        RoleName   @unique
  description String?

  users       User[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Branch {
  id           String        @id @default(cuid())
  name         String        @unique
  address      String
  phone        String?
  openingTime  String?
  closingTime  String?
  status       BranchStatus  @default(ACTIVE)

  users        UserBranch[]
  staff        Staff[]

  appointments Appointment[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserBranch {
  id       String @id @default(cuid())
  userId   String
  branchId String

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

model Staff {
  id          String   @id @default(cuid())
  userId      String   @unique
  branchId    String

  position    String
  skills      String[]
  status      UserStatus @default(ACTIVE)

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch      Branch @relation(fields: [branchId], references: [id])

  services Service[]

  appointments Appointment[]

  tasks Task[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId])
}

enum ServiceCategory {
  HAIR
  BEARD
  FACIAL
  SPA
  NAILS
  MAKEUP
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

model Service {
  id          String @id @default(cuid())

  name        String
  category    ServiceCategory

  duration    Int        // minutes
  price       Decimal    @db.Decimal(10,2)
  tax         Decimal    @db.Decimal(5,2)

  status      ServiceStatus @default(ACTIVE)

  stylists    Staff[]

  appointments Appointment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model Customer {
  id        String   @id @default(cuid())
  userId    String?  @unique

  name      String
  phone     String?   @unique
  email     String?
  dob       DateTime?
  gender    String?

  preferredStylistId String?
  notes     String?
  tags      String[]
  marketingConsent Boolean @default(false)

  user       User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loyalty LoyaltyAccount?

  reviews Review[]

  @@index([name])
  @@index([phone])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id          String   @id @default(cuid())

  customerId  String
  staffId     String
  serviceId   String
  branchId    String

  appointmentDate DateTime

  startTime   String
  endTime     String

  notes       String?

  invoice Invoice?

  status      AppointmentStatus @default(PENDING)

  customer    Customer @relation(fields: [customerId], references: [id])
  staff       Staff @relation(fields: [staffId], references: [id])
  service     Service @relation(fields: [serviceId], references: [id])
  branch      Branch @relation(fields: [branchId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews Review[]

  tasks Task[]

  @@index([appointmentDate])
  @@index([staffId])
  @@index([branchId])
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
}

enum PaymentStatus {
  PAID
  PARTIAL
  REFUNDED
}

model Invoice {
  id            String   @id @default(cuid())

  appointmentId String   @unique

  subtotal      Decimal  @db.Decimal(10,2)
  taxAmount     Decimal  @db.Decimal(10,2)
  discount      Decimal  @db.Decimal(10,2)
  total         Decimal  @db.Decimal(10,2)
  paidAmount    Decimal  @default(0) @db.Decimal(10,2)

  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  items         InvoiceItem[]
  payments      Payment[]

  createdAt     DateTime @default(now())
}

model InvoiceItem {
  id         String @id @default(cuid())

  invoiceId  String

  serviceName String

  price      Decimal @db.Decimal(10,2)

  quantity   Int

  tax        Decimal @db.Decimal(5,2)

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id         String @id @default(cuid())

  invoiceId  String

  amount     Decimal @db.Decimal(10,2)

  method     PaymentMethod

  status     PaymentStatus @default(PAID)

  reference  String?

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
}

enum StockTransactionType {
  PURCHASE
  ADJUSTMENT
  USAGE
}

model InventoryProduct {
  id            String   @id @default(cuid())

  name          String
  sku           String   @unique
  supplier      String?

  costPrice     Decimal  @db.Decimal(10, 2)
  sellingPrice  Decimal  @db.Decimal(10, 2)

  stock         Int      @default(0)
  minimumStock  Int      @default(5)

  transactions  StockTransaction[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StockTransaction {
  id         String @id @default(cuid())

  productId  String
  quantity   Int
  type       StockTransactionType
  note       String?

  product    InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([productId])
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
}

enum LoyaltyType {
  EARN
  REDEEM
  BONUS
  EXPIRE
}

model LoyaltyAccount {
  id             String   @id @default(cuid())
  customerId     String   @unique
  points         Int      @default(0)

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions   LoyaltyTransaction[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LoyaltyTransaction {
  id          String @id @default(cuid())
  accountId   String

  points      Int
  reason      String

  account     LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([accountId])
}

enum ReviewStatus {
  OPEN
  RESOLVED
}

model Review {
  id            String @id @default(cuid())

  appointmentId String @unique
  customerId    String

  rating        Int
  comment       String?
  issueCategory String?

  status        ReviewStatus @default(OPEN)

  appointment Appointment @relation(fields:[appointmentId], references:[id])
  customer    Customer @relation(fields:[customerId], references:[id])

  createdAt DateTime @default(now())
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Task {
  id           String @id @default(cuid())

  title        String
  description  String?

  assistantId  String
  appointmentId String?

  status       TaskStatus @default(PENDING)

  assistant Staff @relation(fields:[assistantId], references:[id])

  appointment Appointment? @relation(fields:[appointmentId], references:[id])

  createdAt DateTime @default(now())
}